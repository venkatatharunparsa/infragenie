# ================================================================
# InfraGenie — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ================================================================

# ----------------------------------------------------------------
# Google Gemini AI
# ----------------------------------------------------------------
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ----------------------------------------------------------------
# AWS Credentials & Region
# ----------------------------------------------------------------
# IAM user / role access key for boto3 SDK calls
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# Target AWS region for all resource deployments
AWS_DEFAULT_REGION=us-east-1

# ----------------------------------------------------------------
# Application Secret
# ----------------------------------------------------------------
# Used for signing JWT tokens and internal service authentication
INFRAGENIE_SECRET=change-me-to-a-long-random-string

# ----------------------------------------------------------------
# Budget Enforcement (USD)
# ----------------------------------------------------------------
# Monthly AWS cost threshold — plans exceeding this will be blocked
BUDGET_THRESHOLD=500

# ----------------------------------------------------------------
# Terraform Remote State Backend (S3 + DynamoDB)
# ----------------------------------------------------------------
# S3 bucket that stores Terraform state files
TERRAFORM_STATE_BUCKET=your-terraform-state-bucket-name
# DynamoDB table used for Terraform state locking
TERRAFORM_LOCK_TABLE=your-terraform-lock-table-name

# ----------------------------------------------------------------
# Database
# ----------------------------------------------------------------
# Async SQLAlchemy connection URL
# SQLite (default, no setup required):
DB_URL=sqlite+aiosqlite:///./infragenie.db
# PostgreSQL example:
# DB_URL=postgresql+asyncpg://user:password@localhost:5432/infragenie

# ----------------------------------------------------------------
# ChromaDB Vector Store
# ----------------------------------------------------------------
# Filesystem path where ChromaDB persists its data
CHROMA_PERSIST_DIR=./chroma_db
